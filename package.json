{
  "name": "mariaprokofieva-org",
  "private": true,
  "type": "module",
  "description": "Source for mariaprokofieva.org",
  "scripts": {
    "clean": "find src . -maxdepth 4 -name '._*' -not -path './node_modules/*' -delete; rm -rf _site",
    "build": "npm run clean && eleventy",
    "start": "npm run clean && eleventy --serve --port 8080"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2"
  }
}
